{
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/orchard-shim\" hook claude-create",
            "timeout": 1800
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/orchard-shim\" hook claude-remove",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
